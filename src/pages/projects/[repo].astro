---
import { Image } from "astro:assets";
import ProjectMedia from "../../components/ProjectMedia.astro";
import { homePages, nextBuild, platformSlug } from "../../data/home";
import { profile } from "../../data/profile";
import type { Platform, Project } from "../../data/types";
import Base from "../../layouts/Base.astro";
import { getRepo, updatedAgo } from "../../lib/github";
import { getReadmeHtml } from "../../lib/readme";
import { getWriteUp, pageName } from "../../lib/writeups";

export function getStaticPaths() {
  return homePages.map(({ project, platform }) => ({ params: { repo: platform?.repo ?? pageName(project)! }, props: { project, platform } }));
}

interface Props {
  project: Project;
  /** The platform this page is for, when that platform's build has its own repo. */
  platform?: Platform;
}

const { project: base, platform } = Astro.props;
const name = pageName(base)!;
const project: Project = platform ? { ...base, repo: platform.repo, demo: platform.demo, clip: platform.clip, media: platform.media } : base;
const repo = project.repo ? await getRepo(project.repo) : undefined;
const readme = project.repo ? await getReadmeHtml(project.repo) : undefined;
// A build whose code is private has its write-up in the site instead of a README.
const WriteUp = project.repo ? undefined : getWriteUp(project.page!);
const demo = project.demo ?? repo?.homepage;
const facts = repo
  ? [repo.language, repo.pushedAt && `updated ${updatedAgo(repo.pushedAt)}`].filter(Boolean).join(" · ")
  : ["Private code", project.stack?.join(", ")].filter(Boolean).join(" · ");

// A project with a platform built in its own repo has a page per repo, and a switch between them.
const platforms = base.platforms ?? [];
const ownPlatforms = platforms.filter((item) => !item.repo).map((item) => item.name);
const switches = platforms.some((item) => item.repo)
  ? [
      { label: ownPlatforms.join(" · ") || base.name, href: `/projects/${name}/`, current: !platform },
      ...platforms.filter((item) => item.repo).map((item) => ({ label: item.name, href: `/projects/${item.repo}/`, current: item === platform })),
    ]
  : [];
const current = switches.find((item) => item.current);
const next = nextBuild(base);
const nextName = pageName(next)!;
---

<Base title={`${current ? `${project.name} for ${current.label}` : project.name} · ${profile.name}`} description={project.summary}>
  <main class="page">
    <a class="home" href="/">{profile.name}</a>

    <header class="head">
      <h1 style={`view-transition-name: project-${name}`}>{project.name}</h1>
      <p class="summary">{project.summary}</p>
      {
        switches.length > 0 ? (
          <nav class="switch" aria-label="Platforms">
            {switches.map((item) => (
              <a href={item.href} aria-current={item.current ? "page" : undefined}>
                {item.current && <span class="pill" style="view-transition-name: platform-pill" />}
                <span class="label" style={`view-transition-name: platform-${platformSlug(item.label)}`}>
                  {item.label}
                </span>
              </a>
            ))}
          </nav>
        ) : (
          platforms.length > 0 && <p class="platforms">{platforms.map((item) => item.name).join(" · ")}</p>
        )
      }
      <p class="links">
        {repo && <a href={repo.url}>GitHub</a>}
        {repo?.release && <a href={repo.release.url}>{repo.release.tag}</a>}
        {demo && <a href={demo}>Live demo</a>}
        {facts && <span class="muted">{facts}</span>}
      </p>
    </header>

    <ProjectMedia project={project} repo={repo} transitionName={`shot-${name}`} />

    {
      WriteUp ? (
        <article class="readme">
          <WriteUp />
        </article>
      ) : readme ? (
        <article class="readme" set:html={readme} />
      ) : (
        <p class="muted">
          The write-up lives in the <a href={repo!.url}>README on GitHub</a>.
        </p>
      )
    }

    <footer class="footer">
      <div class="footer-head">
        <p class="muted">Next project</p>
        <a class="all" href="/#projects">All projects</a>
      </div>
      <a class="next" href={`/projects/${nextName}/`}>
        {
          next.hero && (
            <span class="next-shot" style={`view-transition-name: shot-${nextName}; view-transition-class: shot`}>
              <Image src={next.hero.src} alt="" widths={[320, 640]} sizes="10rem" loading="lazy" />
            </span>
          )
        }
        <span class="next-text">
          <span class="next-name" style={`view-transition-name: project-${nextName}`}>
            {next.name}
          </span>
          <span class="next-summary">{next.summary}</span>
        </span>
      </a>
    </footer>
  </main>
</Base>

<style>
  .page {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    max-width: 44rem;
    margin: 0 auto;
    padding: clamp(3rem, 10vh, 6rem) 1.5rem 3rem;
  }

  .home {
    justify-self: start;
    color: var(--muted);
    text-decoration: none;
  }

  .home:hover {
    color: var(--fg);
  }

  /* Only as wide as the name, so it grows cleanly out of the card's title on the way in. */
  h1 {
    width: fit-content;
    font-size: 1.75rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .summary {
    margin-top: 0.5rem;
    font-size: 1.125rem;
    color: var(--muted);
  }

  .platforms {
    margin-top: 0.75rem;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .switch {
    display: inline-flex;
    gap: 0.25rem;
    margin-top: 1.25rem;
    padding: 0.2rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
  }

  /* The current platform's pill sits behind its label; moving between platforms slides it across. */
  .switch a {
    position: relative;
    isolation: isolate;
    padding: 0.2rem 0.85rem;
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.9375rem;
    text-decoration: none;
    transition: color 150ms var(--ease);
  }

  .switch a:hover,
  .switch a[aria-current="page"] {
    color: var(--fg);
  }

  .switch a[aria-current="page"] {
    font-weight: 500;
  }

  .pill {
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: var(--hover);
  }

  .label {
    display: inline-block;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin-top: 1rem;
  }

  .readme {
    font-size: 1rem;
    line-height: 1.7;
  }

  .readme :global(> * + *) {
    margin-top: 1rem;
  }

  .readme :global(h2) {
    margin-top: 2.75rem;
    font-size: 1.25rem;
    font-weight: 600;
  }

  .readme :global(h3) {
    margin-top: 2rem;
    font-size: 1.0625rem;
    font-weight: 600;
  }

  .readme :global(ul),
  .readme :global(ol) {
    padding-left: 1.25rem;
    list-style: disc;
  }

  .readme :global(ol) {
    list-style: decimal;
  }

  .readme :global(li + li) {
    margin-top: 0.4rem;
  }

  .readme :global(li::marker) {
    color: var(--muted);
  }

  .readme :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 10px;
  }

  .readme :global(p > a > img),
  .readme :global(p > img) {
    display: block;
    border: 1px solid var(--rule);
  }

  .readme :global(code) {
    padding: 0.1em 0.35em;
    border-radius: 4px;
    background: var(--hover);
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.875em;
  }

  .readme :global(pre) {
    overflow-x: auto;
    padding: 1rem;
    border: 1px solid var(--rule);
    border-radius: 10px;
    background: var(--hover);
    line-height: 1.5;
  }

  .readme :global(pre code) {
    padding: 0;
    background: none;
  }

  .readme :global(.highlight) {
    margin-top: 1rem;
  }

  .readme :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }

  .readme :global(th),
  .readme :global(td) {
    padding: 0.4rem 0.6rem 0.4rem 0;
    border-bottom: 1px solid var(--rule);
    text-align: left;
    vertical-align: top;
  }

  .readme :global(blockquote) {
    margin-left: 0;
    padding-left: 1rem;
    border-left: 2px solid var(--rule);
    color: var(--muted);
  }

  .readme :global(.markdown-alert) {
    padding: 0.75rem 1rem;
    border: 1px solid var(--rule);
    border-radius: 10px;
  }

  .readme :global(.markdown-alert-title) {
    font-weight: 600;
  }

  .readme :global(.markdown-alert svg),
  .readme :global(.octicon) {
    display: none;
  }

  .footer {
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
    font-size: 0.9375rem;
  }

  .footer-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 0.9rem;
  }

  .all {
    color: var(--muted);
  }

  .all:hover {
    color: var(--fg);
  }

  .next {
    display: grid;
    grid-template-columns: 10rem minmax(0, 1fr);
    align-items: start;
    gap: 1.25rem;
    text-decoration: none;
  }

  .next-shot {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: 8px;
    background: var(--hover);
    transition: border-color 200ms var(--ease);
  }

  .next:hover .next-shot {
    border-color: var(--muted);
  }

  .next-shot img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 0;
  }

  .next-text {
    display: grid;
    gap: 0.2rem;
  }

  .next-name {
    justify-self: start;
    font-size: 1rem;
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-underline-offset: 0.25em;
    transition: text-decoration-color 150ms var(--ease);
  }

  .next:hover .next-name {
    text-decoration-color: currentColor;
  }

  .next-summary {
    color: var(--muted);
    line-height: 1.55;
  }

  @media (max-width: 640px) {
    .next {
      grid-template-columns: 7.5rem minmax(0, 1fr);
      gap: 1rem;
    }
  }
</style>
