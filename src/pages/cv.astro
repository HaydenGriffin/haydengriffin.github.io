---
import { certifications, experience, skills } from "../data/experience";
import { profile } from "../data/profile";
import { work } from "../data/work";
import Base from "../layouts/Base.astro";

const [current, ...earlier] = experience.filter((role) => !role.organisation.startsWith("University"));
const education = experience.find((role) => role.organisation.startsWith("University"))!;
---

<Base title={`${profile.name} · CV`} description={profile.description}>
  <main class="cv">
    <header>
      <h1>{profile.name}</h1>
      <p class="muted">{profile.role} · {profile.location}</p>
      <p class="contact">
        <a href={`mailto:${profile.email}`}>{profile.email}</a>
        <a href={profile.github}>github.com/HaydenGriffin</a>
        <a href={profile.linkedin}>LinkedIn</a>
      </p>
    </header>

    <section>
      <h2>Experience</h2>
      <article>
        <div class="role-head">
          <h3>{current.title}, {current.organisation}</h3>
          <span class="muted">{current.years}</span>
        </div>
        <ul>
          {work.map((project) => <li><strong>{project.name}.</strong> {project.summary}</li>)}
        </ul>
      </article>
      {
        earlier.map((role) => (
          <article>
            <div class="role-head">
              <h3>
                {role.title}, {role.organisation}
              </h3>
              <span class="muted">{role.years}</span>
            </div>
            {role.note && <p class="muted">{role.note}</p>}
            {role.highlights && (
              <ul>
                {role.highlights.map((line) => (
                  <li>{line}</li>
                ))}
              </ul>
            )}
          </article>
        ))
      }
    </section>

    <section>
      <h2>Education</h2>
      <div class="role-head">
        <h3>{education.title}, {education.organisation}</h3>
        <span class="muted">{education.years}</span>
      </div>
      <ul class="plain">
        {certifications.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section>
      <h2>Skills</h2>
      <dl>
        {
          skills.map((row) => (
            <div>
              <dt>{row.group}</dt>
              <dd>{row.items}</dd>
            </div>
          ))
        }
      </dl>
    </section>
  </main>
</Base>

<style>
  .cv {
    display: grid;
    gap: 2rem;
    max-width: 44rem;
    margin: 0 auto;
    padding: 4rem 1.5rem;
    font-size: 0.9375rem;
  }

  h1 {
    font-size: 1.375rem;
    font-weight: 600;
  }

  h2 {
    margin-bottom: 0.75rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid var(--rule);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
  }

  h3 {
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin-top: 0.35rem;
  }

  article + article {
    margin-top: 1.1rem;
  }

  .role-head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: baseline;
  }

  ul {
    display: grid;
    gap: 0.2rem;
    margin-top: 0.35rem;
    padding-left: 1rem;
    list-style: disc;
  }

  ul.plain {
    padding-left: 0;
    list-style: none;
    color: var(--muted);
  }

  li::marker {
    color: var(--muted);
  }

  dl {
    display: grid;
    gap: 0.25rem;
    margin: 0;
  }

  dl div {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 1rem;
  }

  dt {
    color: var(--muted);
  }

  dd {
    margin: 0;
  }

  @media print {
    :global(:root) {
      --bg: #fff;
      --fg: #111;
      --muted: #555;
      --rule: #ddd;
    }

    .cv {
      max-width: none;
      padding: 0;
      gap: 1.25rem;
      font-size: 9.5pt;
      line-height: 1.45;
    }

    a {
      text-decoration: none;
    }
  }

  @page {
    size: A4;
    margin: 16mm 16mm 14mm;
  }
</style>
