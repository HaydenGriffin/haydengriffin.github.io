---
import { Image } from "astro:assets";
import photo from "../assets/hayden.jpg";
import Build from "../components/Build.astro";
import CopyEmail from "../components/CopyEmail.astro";
import List from "../components/List.astro";
import ProjectRow from "../components/ProjectRow.astro";
import Row from "../components/Row.astro";
import Section from "../components/Section.astro";
import { experience } from "../data/experience";
import { alsoRunning, homeGroups } from "../data/home";
import { profile } from "../data/profile";
import { work } from "../data/work";
import Base from "../layouts/Base.astro";

---

<Base title={`${profile.name} · ${profile.role}`} description={profile.description}>
  <main class="page">
    <header class="intro">
      <Image class="photo" src={photo} alt="Hayden Griffin" widths={[64, 128]} sizes="64px" loading="eager" />
      <div class="who">
        <h1 class="name">{profile.name}</h1>
        <p class="muted">{profile.role}</p>
      </div>
      <div class="bio">
        <p>
          I lead engineering at <a href="https://paymidas.eu">PayMidas</a>, a payments company in Europe, and write a lot of the code. Mostly TypeScript, mostly
          fintech: escrow, payment APIs, onboarding and compliance.
        </p>
        <p>Before PayMidas I was a senior engineer at Jumptech, and before that I worked on IoT and fintech products.</p>
        <p class="spare">In my spare time I build <a href="#projects">open-source apps</a> for TVs and Home Assistant.</p>
      </div>
    </header>

    <Section id="work" title="At PayMidas">
      <List>
        {work.map((project) => <ProjectRow project={project} />)}
      </List>
      <p class="note muted">Most of this code is private. Happy to walk through it.</p>
    </Section>

    <Section id="experience" title="Experience">
      <List>
        {
          experience.map((role) =>
            role.highlights ? (
              <Row title={role.organisation} aside={role.years} summary={role.note ? `${role.title} · ${role.note}` : role.title}>
                <ul class="highlights">
                  {role.highlights.map((line) => (
                    <li>{line}</li>
                  ))}
                </ul>
                {role.href && (
                  <p class="links">
                    <a href={role.href}>{new URL(role.href).hostname.replace(/^www\./, "")}</a>
                  </p>
                )}
              </Row>
            ) : (
              <Row title={role.organisation} href={role.href} aside={role.years} summary={role.note ? `${role.title} · ${role.note}` : role.title} />
            ),
          )
        }
      </List>
    </Section>

    <Section id="projects" title="At home">
      <p class="lead">
        This is my hobby. I run a small homelab with Home Assistant, and I build integrations, apps and local AI tools that solve everyday
        problems around the house. The projects below are open source. If one is useful to you, you can <a href={profile.support}>buy me a coffee</a>.
      </p>
      {
        homeGroups.map((group) => (
          <section class="group" aria-labelledby={`group-${group.id}`}>
            <h3 class="group-title" id={`group-${group.id}`}>
              {group.title}
            </h3>
            <div class="builds">
              {group.projects.map((project) => (
                <Build project={project} />
              ))}
            </div>
          </section>
        ))
      }
      <p class="note muted">
        Also running at home:{" "}
        {alsoRunning.map((item, index) => (
          <>
            {index > 0 && " and "}
            {item.name} ({item.note})
          </>
        ))}
        .
      </p>
    </Section>

    <Section id="contact" title="Contact">
      <div class="contact">
        <p><CopyEmail email={profile.email} /></p>
        <p class="links">
          <a href={profile.github} rel="me">GitHub</a>
          <a href={profile.linkedin} rel="me">LinkedIn</a>
        </p>
        <p class="muted">{profile.location}</p>
      </div>
    </Section>

    <footer class="footer muted">
      <p>© {new Date().getFullYear()} Hayden Griffin</p>
      <a href={profile.support}>Support my work</a>
    </footer>
  </main>
</Base>

<style>
  .page {
    display: grid;
    gap: 4.5rem;
    max-width: 46rem;
    margin: 0 auto;
    padding: clamp(4rem, 14vh, 8rem) 1.5rem 3rem;
  }

  .intro {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    column-gap: 2rem;
    align-items: center;
  }

  .photo {
    justify-self: end;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
  }

  .name {
    font-size: 1.125rem;
    font-weight: 550;
    line-height: 1.4;
  }

  .bio {
    grid-column: 2;
    display: grid;
    gap: 1rem;
    margin-top: 1.75rem;
    max-width: 34rem;
    font-size: 1.125rem;
    line-height: 1.6;
  }

  .spare {
    color: var(--muted);
  }

  .lead {
    padding-block: 0.5rem;
    margin-bottom: 0.25rem;
  }

  .group {
    margin-top: 2.5rem;
  }

  .group-title {
    padding-bottom: 0.5rem;
    margin-bottom: 1.25rem;
    border-bottom: 1px solid var(--rule);
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .builds {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem 2rem;
  }

  /* Three to a group: the first takes the full width, the other two share a row. */
  .builds > :global(:first-child) {
    grid-column: 1 / -1;
  }

  .group + .note {
    margin-top: 2.5rem;
    max-width: 34rem;
  }

  .note {
    margin-top: 1rem;
    font-size: 0.9375rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin-top: 0.5rem;
  }

  .highlights {
    display: grid;
    gap: 0.4rem;
    padding-left: 1rem;
    list-style: disc;
  }

  .highlights li::marker {
    color: var(--muted);
  }

  .contact {
    display: grid;
    gap: 0.25rem;
    padding-block: 0.5rem;
  }

  .contact .links {
    margin-top: 0;
  }

  .footer {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-left: 10rem;
    font-size: 0.875rem;
  }

  .footer a:hover {
    color: var(--fg);
  }

  @media (prefers-reduced-motion: no-preference) {
    .page > * {
      animation: enter 700ms var(--ease) both;
    }

    .page > :nth-child(2) {
      animation-delay: 80ms;
    }

    .page > :nth-child(3) {
      animation-delay: 160ms;
    }

    .page > :nth-child(n + 4) {
      animation-delay: 240ms;
    }
  }

  @keyframes enter {
    from {
      opacity: 0;
      transform: translateY(6px);
      filter: blur(2px);
    }
  }

  @media (max-width: 640px) {
    .page {
      gap: 3.5rem;
    }

    .intro {
      grid-template-columns: 56px minmax(0, 1fr);
      column-gap: 1rem;
    }

    .photo {
      width: 56px;
      height: 56px;
    }

    .bio {
      grid-column: 1 / -1;
    }

    .builds {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
    }

    .footer {
      padding-left: 0;
    }
  }
</style>
