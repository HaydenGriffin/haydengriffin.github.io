---
import { home } from "../../data/home";
import { route } from "../../data/route";
import { work } from "../../data/work";
import { FIRST_EASTING, SHEET, TOP_NORTHING, gridRef } from "../../lib/grid";
import { type Box, UNIT, blob, buildTerrain, buildings, scatterTrees, smoothPath } from "../../lib/terrain";
import { type Label, RIVER_WIDENS_AT, copses, labels, placeNames, river, roads, settlementSize, woodland } from "./geography";

const width = SHEET.columns * UNIT;
const height = SHEET.rows * UNIT;
const margin = { x: 44, y: 40 };

const terrain = buildTerrain();

const features = [...route, ...work, ...home].map((feature) => ({
  id: feature.id,
  name: "name" in feature ? feature.name : feature.organisation,
  position: feature.position,
  ref: gridRef(feature.position),
  label: labels[feature.id]!,
}));

const settlements = features
  .filter((feature) => settlementSize[feature.id])
  .flatMap((feature, k) => {
    const { count, spread } = settlementSize[feature.id]!;
    return buildings(feature.position, count, spread, 400 + k * 17);
  });

const woods = [
  { path: blob(woodland.center, woodland.radius, 71, 40), main: true },
  ...copses.map((copse, k) => ({ path: blob(copse.center, copse.radius, 90 + k, 22), main: false })),
];

/** Rough extent of a label in grid units, so trees can leave room for the lettering. */
function labelBox(at: { x: number; y: number }, label: Label): Box {
  const spacing = label.class === "area" ? 0.9 : 0.55;
  const width = (label.text.length * label.size * spacing) / UNIT;
  const height = (label.size * 1.1) / UNIT;
  const x = at.x + label.dx;
  const y = at.y + label.dy;
  const left = label.anchor === "middle" ? x - width / 2 : label.anchor === "end" ? x - width : x;
  return { left: left - 0.12, right: left + width + 0.12, top: y - height, bottom: y + 0.15 };
}

const keepClear = [
  ...features.map((feature) => labelBox(feature.position, feature.label)),
  ...placeNames.map((name) => labelBox(name, name)),
];
const avoid = features.map((feature) => feature.position);
const trees = [
  ...scatterTrees(woodland.center, woodland.radius, 46, 5, avoid, keepClear),
  ...copses.flatMap((copse, k) => scatterTrees(copse.center, copse.radius, 5, 30 + k, avoid, keepClear)),
];

const upperRiver = smoothPath(river.slice(0, RIVER_WIDENS_AT + 1));
const lowerRiver = smoothPath(river.slice(RIVER_WIDENS_AT));
const routePath = smoothPath([...route.map((stop) => stop.position)]);
const roadPaths = roads.map((road) => ({ kind: road.kind, d: smoothPath(road.points) }));
const bridge = work.find((feature) => feature.id === "payments-bridge")!.position;

const eastings = Array.from({ length: SHEET.columns + 1 }, (_, k) => ({ x: k * UNIT, label: FIRST_EASTING + k }));
const northings = Array.from({ length: SHEET.rows + 1 }, (_, k) => ({ y: k * UNIT, label: TOP_NORTHING - k }));

const px = (n: number) => Math.round(n * UNIT * 10) / 10;
const paymidas = features.find((feature) => feature.id === "paymidas")!;
---

<figure class="overview" data-overview>
  <div class="overview-scroll" data-overview-scroll tabindex="0" aria-label="Overview map. Scroll sideways to see all of it.">
    <svg
      class="overview-sheet"
      viewBox={`${-margin.x} ${-margin.y} ${width + margin.x * 2} ${height + margin.y * 2}`}
      aria-labelledby="overview-title"
      role="group"
      data-sheet
    >
      <title id="overview-title">Overview map of Hayden Griffin's work, from university in the hills to PayMidas on the coast, with home builds in the woodland</title>
      <defs>
        <clipPath id="neatline"><rect width={width} height={height}></rect></clipPath>
        <symbol id="tree-broad" viewBox="-6 -8 12 14">
          <circle cy="-3" r="4"></circle>
          <path d="M0 1V5"></path>
        </symbol>
        <symbol id="tree-conifer" viewBox="-6 -8 12 14">
          <path d="M0 -7L4 2H-4Z"></path>
          <path d="M0 2V5"></path>
        </symbol>
      </defs>

      <g clip-path="url(#neatline)" id="sheet-art">
        <g class="plate plate-water">
          <rect class="sea" width={width} height={height}></rect>
          <path class="land" d={terrain.landPath}></path>
          <path class="coast" d={terrain.landPath}></path>
          <path class="river river-upper" d={upperRiver}></path>
          <path class="river river-lower" d={lowerRiver}></path>
        </g>

        <g class="plate plate-fills">
          {woods.map((wood) => <path class:list={["wood", { "wood-main": wood.main }]} d={wood.path}></path>)}
          {trees.map((tree) => <use href={`#tree-${tree.kind}`} class="tree" x={tree.x - 5} y={tree.y - 7} width="10" height="12"></use>)}
        </g>

        <g class="plate plate-contours">
          {terrain.contours.map((contour) => <path class:list={["contour", { "contour-index": contour.index }]} d={contour.path}></path>)}
          {
            terrain.contours
              .filter((contour) => contour.label)
              .map(({ label }) => (
                <text class="contour-label" x={label!.x} y={label!.y} transform={`rotate(${label!.angle} ${label!.x} ${label!.y})`} dy="3.5">
                  {label!.text}
                </text>
              ))
          }
        </g>

        <g class="plate plate-keyline">
          {roadPaths.map((road) => <path class:list={["road-casing", `road-${road.kind}`]} d={road.d}></path>)}
          {roadPaths.map((road) => <path class:list={["road-fill", `road-${road.kind}`]} d={road.d}></path>)}
          <g class="bridge" transform={`translate(${px(bridge.x)} ${px(bridge.y)}) rotate(-20)`}>
            <path d="M-11 -9Q-7 -6 -7 0Q-7 6 -11 9M11 -9Q7 -6 7 0Q7 6 11 9"></path>
          </g>
          {
            settlements.map((b) => (
              <rect class="building" x={b.x - b.w / 2} y={b.y - b.h / 2} width={b.w} height={b.h} transform={`rotate(${b.angle} ${b.x} ${b.y})`}></rect>
            ))
          }
          <path class="footpath" d={routePath}></path>
          {route.map((stop) => <circle class="waypoint" cx={px(stop.position.x)} cy={px(stop.position.y)} r="5"></circle>)}
          <g class="trig" transform={`translate(${terrain.summit.x} ${terrain.summit.y})`}>
            <path d="M0 -7L6.5 4.5H-6.5Z"></path>
            <circle r="1.6"></circle>
            <text x="9" y="4">{terrain.summit.height}</text>
          </g>
        </g>

        <g class="plate plate-grid" aria-hidden="true">
          {eastings.map(({ x }) => <line class="grid-line" x1={x} x2={x} y1="0" y2={height}></line>)}
          {northings.map(({ y }) => <line class="grid-line" x1="0" x2={width} y1={y} y2={y}></line>)}
        </g>

        <g class="plate plate-lettering">
          {
            placeNames.map((name) => (
              <text
                class:list={["label", `label-${name.class}`, name.ground && `on-${name.ground}`]}
                x={px(name.x)}
                y={px(name.y)}
                text-anchor={name.anchor}
                font-size={name.size}
                aria-hidden="true"
              >
                {name.text}
              </text>
            ))
          }
          {
            features.map((feature) => (
              <a href={`#${feature.id}`} class="feature" data-feature={feature.id} data-name={feature.name} data-ref={feature.ref}>
                <circle class="feature-hit" cx={px(feature.position.x)} cy={px(feature.position.y)} r="22"></circle>
                <text
                  class:list={["label", `label-${feature.label.class}`, feature.label.ground && `on-${feature.label.ground}`, { "label-caps": feature.label.caps }]}
                  x={px(feature.position.x + feature.label.dx)}
                  y={px(feature.position.y + feature.label.dy)}
                  text-anchor={feature.label.anchor ?? "start"}
                  font-size={feature.label.size}
                >
                  {feature.label.text}
                </text>
              </a>
            ))
          }
        </g>

      </g>

      <g class="crosshair" clip-path="url(#neatline)" data-crosshair aria-hidden="true">
        <line data-crosshair-x y1="0" y2={height}></line>
        <line data-crosshair-y x1="0" x2={width}></line>
      </g>

      <g class="plate plate-margin" aria-hidden="true">
        <rect class="neatline" width={width} height={height}></rect>
        <rect class="outer-line" x={-margin.x + 8} y={-margin.y + 8} width={width + margin.x * 2 - 16} height={height + margin.y * 2 - 16}></rect>
        {
          eastings.map(({ x, label }) => (
            <>
              <text class="margin-figure" x={x} y={-12} text-anchor="middle">{label}</text>
              <text class="margin-figure" x={x} y={height + 23} text-anchor="middle">{label}</text>
            </>
          ))
        }
        {
          northings.map(({ y, label }) => (
            <>
              <text class="margin-figure" x={-12} y={y + 4.5} text-anchor="end">{label}</text>
              <text class="margin-figure" x={width + 12} y={y + 4.5}>{label}</text>
            </>
          ))
        }
        <text class="margin-square" x={-26} y={-18} text-anchor="middle">HG</text>
      </g>
    </svg>
  </div>
  <figcaption class="readout" aria-live="off">
    <span class="readout-name" data-readout-name>{paymidas.name}</span>
    <span class="readout-ref" data-readout-ref data-default-ref={paymidas.ref} data-default-name={paymidas.name}>{paymidas.ref}</span>
  </figcaption>
</figure>

<style>
  .overview {
    position: relative;
    margin: 0;
  }

  .overview-scroll {
    overflow: auto hidden;
    overscroll-behavior-x: contain;
    scrollbar-width: thin;
  }

  .overview-sheet {
    width: 100%;
    height: auto;
    overflow: visible;
    font-family: var(--face-text);
    user-select: none;
  }

  @media (max-width: 760px) {
    .overview-sheet {
      width: 820px;
      max-width: none;
    }
  }

  .sea {
    fill: var(--water);
  }

  .land {
    fill: var(--paper);
  }

  .coast {
    fill: none;
    stroke: var(--water-line);
    stroke-width: 1.4;
  }

  .river {
    fill: none;
    stroke: var(--water-line);
    stroke-linecap: round;
  }

  .river-upper {
    stroke-width: 2.4;
  }

  .river-lower {
    stroke-width: 5;
  }

  .wood {
    fill: var(--wood);
    stroke: var(--wood-line);
    stroke-width: 0.8;
  }

  .tree {
    fill: var(--wood-line);
    stroke: var(--wood-line);
    stroke-width: 1.2;
  }

  .contour {
    fill: none;
    stroke: var(--contour);
    stroke-width: 0.7;
  }

  .contour-index {
    stroke: var(--contour-index);
    stroke-width: 1.3;
  }

  .contour-label {
    fill: var(--contour-ink);
    font-size: 10px;
    text-anchor: middle;
    paint-order: stroke;
    stroke: var(--paper);
    stroke-width: 4px;
  }

  .road-casing {
    fill: none;
    stroke: var(--ink);
    stroke-linecap: round;
  }

  .road-fill {
    fill: none;
    stroke-linecap: round;
  }

  .road-casing.road-b {
    stroke-width: 7.5;
  }

  .road-fill.road-b {
    stroke: var(--road-b);
    stroke-width: 5.3;
  }

  .road-casing.road-minor {
    stroke-width: 5.6;
  }

  .road-fill.road-minor {
    stroke: var(--road-minor);
    stroke-width: 3.6;
  }

  .bridge path {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.6;
  }

  .building {
    fill: var(--ink);
    opacity: 0.82;
  }

  .footpath {
    fill: none;
    stroke: var(--path);
    stroke-width: 2.2;
    stroke-dasharray: 7 5;
  }

  .waypoint {
    fill: var(--paper);
    stroke: var(--path);
    stroke-width: 2.2;
  }

  .trig path {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.3;
  }

  .trig circle {
    fill: var(--ink);
  }

  .trig text {
    fill: var(--ink);
    font-size: 10px;
  }

  .grid-line {
    stroke: var(--grid);
    stroke-width: 0.8;
    opacity: 0.55;
  }

  .neatline {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.6;
  }

  .outer-line {
    fill: none;
    stroke: var(--ink);
    stroke-width: 0.6;
  }

  .margin-figure {
    fill: var(--grid-ink);
    font-size: 13px;
    font-weight: 500;
  }

  .margin-square {
    fill: var(--grid-ink);
    font-family: var(--face-letter);
    font-weight: 700;
    font-size: 15px;
  }

  .label {
    fill: var(--ink);
    paint-order: stroke;
    stroke: var(--paper);
    stroke-width: 3.5px;
    stroke-linejoin: round;
  }

  .label.on-wood {
    stroke: var(--wood);
  }

  .label-settlement {
    font-family: var(--face-letter);
    font-weight: 700;
  }

  .label-caps {
    font-weight: 800;
    letter-spacing: 0.04em;
  }

  .label-water {
    fill: var(--water-ink);
    font-style: italic;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .label-area {
    font-weight: 500;
    letter-spacing: 0.28em;
  }

  .label-antiquity {
    font-family: var(--face-antiquity);
  }

  .label.on-sea {
    stroke: var(--water);
    letter-spacing: 0.3em;
  }

  .feature {
    cursor: pointer;
    text-decoration: none;
    outline: none;
  }

  .feature-hit {
    fill: transparent;
  }

  .feature .label {
    transition: fill 160ms var(--ease-out);
  }

  .feature:hover .label,
  .feature:focus-visible .label {
    fill: var(--cover);
  }

  .feature:focus-visible .feature-hit {
    stroke: var(--cover);
    stroke-width: 2.5;
  }

  .crosshair {
    pointer-events: none;
    opacity: 0;
    transition: opacity 200ms var(--ease-out);
  }

  .crosshair line {
    stroke: var(--grid-ink);
    stroke-width: 0.9;
    stroke-dasharray: 2 3;
  }

  [data-overview].is-reading .crosshair {
    opacity: 1;
  }

  .readout {
    display: flex;
    gap: var(--space-2);
    align-items: baseline;
    justify-content: flex-end;
    margin-top: var(--space-2);
    font-size: var(--step--1);
    color: var(--grid-ink);
  }

  .readout-name {
    color: var(--ink-soft);
  }

  .readout-ref {
    min-width: 8.5ch;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  /* Plates register one after another, each landing a little out of register and settling. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .plate {
      animation: register 1100ms var(--ease-out) both;
    }

    :global(.js) .plate-grid {
      animation-delay: 80ms;
      --from: translate(-10px, 6px);
    }

    :global(.js) .plate-water {
      animation-delay: 260ms;
      --from: translate(12px, -6px);
    }

    :global(.js) .plate-contours {
      animation-delay: 440ms;
      --from: translate(-6px, -12px);
    }

    :global(.js) .plate-fills {
      animation-delay: 620ms;
      --from: translate(10px, 10px);
    }

    :global(.js) .plate-keyline {
      animation-delay: 800ms;
      --from: translate(-12px, 4px);
    }

    :global(.js) .plate-lettering {
      animation-delay: 1000ms;
      --from: translate(6px, -9px);
    }

    :global(.js) .plate-margin {
      animation-delay: 0ms;
      --from: none;
    }
  }

  @keyframes register {
    from {
      opacity: 0;
      transform: var(--from, none);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  const overview = document.querySelector<HTMLElement>("[data-overview]");
  const sheet = overview?.querySelector<SVGSVGElement>("[data-sheet]");
  const scroller = overview?.querySelector<HTMLElement>("[data-overview-scroll]");

  if (overview && sheet && scroller) {
    const unit = 50;
    const columns = 20;
    const rows = 13;
    const crossX = sheet.querySelector<SVGLineElement>("[data-crosshair-x]")!;
    const crossY = sheet.querySelector<SVGLineElement>("[data-crosshair-y]")!;
    const nameEl = overview.querySelector<HTMLElement>("[data-readout-name]")!;
    const refEl = overview.querySelector<HTMLElement>("[data-readout-ref]")!;
    const fallback = { name: refEl.dataset.defaultName ?? "", ref: refEl.dataset.defaultRef ?? "" };

    const tenths = (value: number) => String(Math.floor(value * 10) % 1000).padStart(3, "0");
    const show = (name: string, ref: string) => {
      nameEl.textContent = name;
      refEl.textContent = ref;
    };

    sheet.addEventListener("pointermove", (event) => {
      const matrix = sheet.getScreenCTM();
      if (!matrix) return;
      const point = new DOMPoint(event.clientX, event.clientY).matrixTransform(matrix.inverse());
      const x = point.x / unit;
      const y = point.y / unit;
      if (x < 0 || y < 0 || x > columns || y > rows) {
        overview.classList.remove("is-reading");
        return;
      }
      overview.classList.add("is-reading");
      crossX.setAttribute("x1", String(point.x));
      crossX.setAttribute("x2", String(point.x));
      crossY.setAttribute("y1", String(point.y));
      crossY.setAttribute("y2", String(point.y));
      const feature = (event.target as Element).closest<SVGAElement>("[data-feature]");
      const ref = `HG ${tenths(40 + x)} ${tenths(93 - y)}`;
      show(feature?.dataset.name ?? "Grid reference", feature?.dataset.ref ?? ref);
    });

    sheet.addEventListener("pointerleave", () => {
      overview.classList.remove("is-reading");
      show(fallback.name, fallback.ref);
    });

    sheet.querySelectorAll<SVGAElement>("[data-feature]").forEach((feature) => {
      feature.addEventListener("focus", () => show(feature.dataset.name ?? "", feature.dataset.ref ?? ""));
      feature.addEventListener("blur", () => show(fallback.name, fallback.ref));
    });

    // On narrow screens the sheet scrolls sideways; open it over PayMidas, where the work is now.
    if (scroller.scrollWidth > scroller.clientWidth) {
      scroller.scrollLeft = (scroller.scrollWidth - scroller.clientWidth) * 0.72;
    }
  }
</script>
