---
import { UNIT } from "../../lib/terrain";

/** An enlarged window onto the overview sheet. It reuses the sheet's artwork, so nothing is drawn twice. */
interface Props {
  from: { x: number; y: number };
  to: { x: number; y: number };
  caption: string;
  class?: string;
}

const { from, to, caption, class: className } = Astro.props;
const viewBox = [from.x * UNIT, from.y * UNIT, (to.x - from.x) * UNIT, (to.y - from.y) * UNIT].join(" ");
---

<figure class:list={["inset", className]}>
  <svg class="inset-art" viewBox={viewBox} aria-hidden="true">
    <use href="#sheet-art"></use>
  </svg>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .inset {
    margin: 0;
  }

  .inset-art {
    width: 100%;
    height: auto;
    border: 2px solid var(--ink);
    outline: 0.6px solid var(--ink);
    outline-offset: 5px;
    background: var(--paper);
  }

  figcaption {
    margin-top: var(--space-2);
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
</style>
