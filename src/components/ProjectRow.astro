---
import type { Link, Project } from "../data/types";
import { getRepo, updatedAgo } from "../lib/github";
import ProjectMedia from "./ProjectMedia.astro";
import Row from "./Row.astro";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const repo = project.repo ? await getRepo(project.repo) : undefined;

const links: Link[] = [
  ...(repo ? [{ label: "How it works", href: `/projects/${project.repo}/` }] : []),
  ...(project.links ?? []),
  ...(repo ? [{ label: "GitHub", href: repo.url }] : []),
];
const primary = repo ? { label: "GitHub", href: repo.url } : project.links?.[0];
const facts = [repo?.language, repo?.pushedAt && `updated ${updatedAgo(repo.pushedAt)}`, project.stack?.join(", ")].filter(Boolean).join(" · ");
const hasMore = Boolean(project.details || facts || project.media || project.clip || project.demo || repo?.hero || links.length);
const transitionName = project.repo ? `project-${project.repo}` : undefined;
---

{
  hasMore ? (
    <Row title={project.name} summary={project.summary} aside={primary?.label} asideHref={primary?.href} transitionName={transitionName}>
      {project.details && <p>{project.details}</p>}
      <ProjectMedia project={project} repo={repo} />
      {facts && <p class="facts">{facts}</p>}
      {links.length > 0 && (
        <p class="links">
          {links.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))}
        </p>
      )}
    </Row>
  ) : (
    <Row title={project.name} summary={project.summary} />
  )
}

<style>
  .facts {
    margin-top: 0.75rem;
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin-top: 0.5rem;
  }
</style>
