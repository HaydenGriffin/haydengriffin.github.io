---
import { certifications, route } from "../../data/route";
import { gridRef } from "../../lib/grid";
import FeatureName from "../FeatureName.astro";

const stops = [...route].reverse();
---

<section class="sheet-section route" id="route" aria-labelledby="route-title">
  <div class="section-head">
    <h2 class="route-title" id="route-title">The route</h2>
    <p class="section-lede">
      The career path, from PayMidas on the coast back up to university in the hills. Names before 2020 are lettered as antiquities, the way old sites are on the map.
    </p>
  </div>

  <ol class="stops">
    {
      stops.map((stop) => (
        <li class="stop" id={stop.id}>
          <p class="stop-years">
            {stop.years}
            <span class="stop-ref">{gridRef(stop.position)}</span>
          </p>
          <span class="stop-mark" aria-hidden="true" />
          <div class="stop-body">
            <FeatureName of={stop.class}>{stop.organisation}</FeatureName>
            <p class="stop-title">
              {stop.title}
              <span class="stop-where">{stop.where}</span>
            </p>
            <ul class="stop-highlights">
              {stop.highlights.map((line) => (
                <li>{line}</li>
              ))}
            </ul>
          </div>
        </li>
      ))
    }
  </ol>

  <div class="certs">
    <h3 class="certs-title">Also on the way</h3>
    <ul>
      {certifications.map((item) => <li>{item}</li>)}
    </ul>
  </div>
</section>

<style>
  .route-title {
    font-family: var(--face-letter);
    font-weight: 800;
    font-size: var(--step-3);
    color: #1f6a2c;
  }

  .stops {
    display: grid;
    position: relative;
  }

  .stops::before {
    content: "";
    position: absolute;
    top: 0.6rem;
    bottom: 0.6rem;
    left: calc(9rem + var(--space-4) + 0.6rem - 1.25px);
    border-left: 2.5px dashed var(--path);
  }

  .stop {
    display: grid;
    grid-template-columns: 9rem 1.2rem minmax(0, 46rem);
    column-gap: var(--space-4);
    padding-bottom: var(--space-5);
    scroll-margin-top: var(--space-5);
  }

  .stop:last-child {
    padding-bottom: 0;
  }

  .stop-years {
    padding-top: 0.35rem;
    text-align: right;
    font-weight: 600;
    color: var(--ink-soft);
  }

  .stop-mark {
    position: relative;
    z-index: 1;
    width: 1.2rem;
    height: 1.2rem;
    margin-top: 0.45rem;
    border: 2.5px solid var(--path);
    border-radius: 50%;
    background: var(--paper);
  }

  .stop:first-child .stop-mark {
    background: var(--path);
  }

  .stop-title {
    margin-top: var(--space-1);
    font-weight: 600;
  }

  .stop-where {
    display: block;
    font-weight: 400;
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  .stop-highlights {
    display: grid;
    gap: var(--space-1);
    margin-top: var(--space-3);
    max-width: 62ch;
    color: var(--ink-soft);
  }

  .stop-highlights li {
    position: relative;
    padding-left: 1.1rem;
  }

  .stop-highlights li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.68em;
    width: 0.45rem;
    height: 2px;
    background: var(--contour-index);
  }

  .stop-ref {
    display: block;
    margin-top: 0.15rem;
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--grid-ink);
  }

  .certs {
    margin-top: var(--space-6);
    margin-left: calc(9rem + 1.2rem + var(--space-4) * 2);
    max-width: 46rem;
  }

  .certs-title {
    font-family: var(--face-letter);
    font-weight: 700;
    font-size: var(--step-1);
  }

  .certs ul {
    display: grid;
    gap: var(--space-1);
    margin-top: var(--space-2);
    color: var(--ink-soft);
  }

  @media (max-width: 760px) {
    .stops::before {
      left: 0.6rem;
    }

    .stop {
      grid-template-columns: 1.2rem minmax(0, 1fr);
      column-gap: var(--space-3);
    }

    .stop-ref {
      display: inline;
      margin-left: var(--space-2);
    }

    .stop-years {
      grid-column: 2;
      grid-row: 1;
      padding-top: 0;
      text-align: left;
      font-size: var(--step--1);
    }

    .stop-mark {
      grid-column: 1;
      grid-row: 1 / span 2;
      margin-top: 0.2rem;
    }

    .stop-body {
      grid-column: 2;
    }

    .certs {
      margin-left: calc(1.2rem + var(--space-3));
    }
  }
</style>
