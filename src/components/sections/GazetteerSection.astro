---
import { home } from "../../data/home";
import { route } from "../../data/route";
import { work } from "../../data/work";
import type { FeatureClass } from "../../data/types";
import { gridRef } from "../../lib/grid";

const kinds: Record<FeatureClass, string> = {
  settlement: "place",
  water: "water",
  area: "area",
  antiquity: "antiquity",
};

const entries = [
  ...work.map((f) => ({ id: f.id, name: f.name, class: f.class, position: f.position })),
  ...home.map((f) => ({ id: f.id, name: f.name, class: f.class, position: f.position })),
  ...route.map((s) => ({ id: s.id, name: s.organisation, class: s.class, position: s.position })),
].sort((a, b) => a.name.localeCompare(b.name, "en-GB"));
---

<section class="sheet-section gazetteer" id="gazetteer" aria-labelledby="gazetteer-title">
  <h2 class="gazetteer-title" id="gazetteer-title">Gazetteer</h2>
  <ol class="places">
    {
      entries.map((entry) => (
        <li>
          <a href={`#${entry.id}`} class={`place place-${entry.class}`}>
            <span class="place-name">{entry.name}</span>
            <span class="place-kind">{kinds[entry.class]}</span>
            <span class="place-ref">{gridRef(entry.position)}</span>
          </a>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .gazetteer-title {
    padding-bottom: var(--space-2);
    border-bottom: 2px solid var(--ink);
    font-family: var(--face-letter);
    font-weight: 800;
    font-size: var(--step-2);
  }

  .places {
    columns: 3 18rem;
    column-gap: var(--space-5);
    margin-top: var(--space-3);
  }

  .places li {
    break-inside: avoid;
  }

  .place {
    display: flex;
    align-items: baseline;
    gap: var(--space-1);
    padding-block: 0.3rem;
    text-decoration: none;
  }

  .place-name {
    font-weight: 600;
    text-decoration: underline dashed var(--path) 2px;
    text-underline-offset: 0.22em;
  }

  .place:hover .place-name {
    text-decoration-style: solid;
  }

  .place-kind {
    flex: 1;
    display: flex;
    gap: var(--space-1);
    align-items: baseline;
    font-size: var(--step--1);
    color: var(--ink-soft);
    font-style: italic;
  }

  .place-kind::after {
    content: "";
    flex: 1;
    border-bottom: 1.5px dotted color-mix(in srgb, var(--ink) 40%, transparent);
  }

  .place-ref {
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--grid-ink);
  }

  .place-antiquity .place-name {
    font-family: var(--face-antiquity);
    font-weight: 400;
    font-size: 1.15rem;
  }

  .place-water .place-name {
    font-style: italic;
    color: var(--water-ink);
  }
</style>
