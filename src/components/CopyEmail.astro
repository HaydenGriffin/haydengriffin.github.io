---
interface Props {
  email: string;
  tone?: "cover" | "paper";
}

const { email, tone = "cover" } = Astro.props;
---

<div class:list={["email", `email-${tone}`]} data-copy-email>
  <a class="email-address" href={`mailto:${email}`}>{email}</a>
  <button class="email-copy" type="button" data-copy={email} hidden>
    <span data-copy-label>Copy</span>
  </button>
</div>

<style>
  .email {
    display: flex;
    flex-wrap: nowrap;
    align-items: stretch;
    justify-self: start;
    max-width: 100%;
  }

  .email-address {
    min-width: 0;
    padding: 0.6rem 0.9rem;
    font-size: clamp(0.875rem, 0.8rem + 0.3vw, 1rem);
    background: var(--ink);
    color: #fff;
    font-weight: 600;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .email-address:hover {
    background: #000;
  }

  .email-copy {
    flex: none;
    min-width: 4.75rem;
    padding: 0.6rem 0.9rem;
    border: 2px solid var(--ink);
    background: transparent;
    font-weight: 600;
    transition: background-color 160ms var(--ease-out);
  }

  .email-cover .email-copy:hover {
    background: color-mix(in srgb, #fff 30%, transparent);
  }

  .email-paper .email-copy:hover {
    background: var(--paper-deep);
  }

  .email-copy[data-copied] {
    background: var(--ink);
    color: #fff;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-copy-email]").forEach((root) => {
    const button = root.querySelector<HTMLButtonElement>("[data-copy]");
    const label = root.querySelector<HTMLElement>("[data-copy-label]");
    if (!button || !label || !navigator.clipboard) return;
    button.hidden = false;
    let timer: number | undefined;
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? "");
        label.textContent = "Copied";
        button.dataset.copied = "";
      } catch {
        label.textContent = "Couldn’t copy";
      }
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        label.textContent = "Copy";
        delete button.dataset.copied;
      }, 2200);
    });
  });
</script>
