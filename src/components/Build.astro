---
/**
 * A home build shown as a card: its hero image, its name, what it runs on and what it is.
 * The image and the name open the project page, where the releases, the code and each platform's build live.
 * Beside the name is the one thing worth reaching straight from the card: a live demo, or a note that the code is private.
 * On a desktop pointer, resting on a card's image opens a larger player over the card (see PreviewPlayer):
 * its clip, or when it has none, a slideshow of its screenshots and each platform's.
 */
import { getImage, Image } from "astro:assets";
import { platformSlug } from "../data/home";
import type { Project } from "../data/types";
import { clipSize } from "../lib/clips";
import { getRepo } from "../lib/github";
import { pageName } from "../lib/writeups";

interface Props {
  /** A project with a repo or a page, and a hero image. */
  project: Project;
}

const { project } = Astro.props;
const hero = project.hero!;
const clip = project.clip;
const name = pageName(project)!;
const repo = project.repo ? await getRepo(project.repo) : undefined;
const page = `/projects/${name}/`;
const demo = project.demo ?? repo?.homepage;
const platforms = (project.platforms ?? []).map((platform) => ({ name: platform.name, slug: platformSlug(platform.name) }));
const featured = Boolean(project.featured);
const size = clip && (await clipSize(clip.name));
const pictures = clip ? [] : [...(project.media ?? []), ...(project.platforms ?? []).flatMap((platform) => platform.media ?? [])];
const slides = await Promise.all(pictures.map(async (picture) => (await getImage({ src: picture.src, width: Math.min(1440, picture.src.width) })).src));
---

<article
  class:list={["build", { featured }]}
  data-platforms={platforms.map((platform) => platform.slug).join(" ")}
  data-clip={clip?.name}
  data-clip-shape={clip?.shape}
  data-clip-width={size?.width}
  data-clip-height={size?.height}
  data-slides={slides.length > 0 ? JSON.stringify(slides) : undefined}
  data-page={page}
>
  <a class="shot" href={page} tabindex="-1" style={`view-transition-name: shot-${name}; view-transition-class: shot`}>
    <Image
      src={hero.src}
      alt={hero.alt}
      widths={featured ? [560, 800, 1100, 1600] : [400, 560, 800, 1100]}
      sizes={featured ? "(max-width: 640px) calc(100vw - 3rem), 528px" : "(max-width: 640px) calc(100vw - 3rem), 250px"}
      loading={featured ? "eager" : "lazy"}
    />
  </a>
  <div class="line">
    <h3 class="name">
      <a class="title" href={page} style={`view-transition-name: project-${name}`}>{project.name}</a>
    </h3>
    {demo ? <a class="aside" href={demo}>Live demo</a> : !repo && <span class="aside muted">Private code</span>}
  </div>
  {
    platforms.length > 0 && (
      <p class="platforms">
        {platforms.map((platform, index) => (
          <>
            {index > 0 && " · "}
            <span data-platform={platform.slug}>{platform.name}</span>
          </>
        ))}
      </p>
    )
  }
  <p class="summary">{project.summary}</p>
</article>

<style>
  .build {
    display: grid;
    align-content: start;
    transition: opacity 300ms var(--ease);
  }

  .featured {
    grid-column: 1 / -1;
  }

  .featured .summary {
    max-width: 30rem;
  }

  /* Picked out by a platform in the "Runs on" line: the builds that do not run on it step back. */
  .build.dimmed {
    opacity: 0.28;
  }

  .shot {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    margin-bottom: 0.8rem;
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: 10px;
    background: var(--hover);
    transition: border-color 200ms var(--ease);
  }

  .build:has(.title:hover) .shot,
  .shot:hover {
    border-color: var(--muted);
  }

  .shot img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 0;
  }

  .line {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  .name {
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.4;
  }

  .title {
    text-decoration: none;
  }

  .title:hover {
    text-decoration: underline;
    text-decoration-color: currentColor;
  }

  .aside {
    flex: none;
    font-size: 0.9375rem;
  }

  .platforms {
    margin-top: 0.1rem;
    color: var(--muted);
    font-size: 0.875rem;
  }

  .platforms span {
    transition: color 200ms var(--ease);
  }

  .platforms span.picked {
    color: var(--fg);
    font-weight: 500;
  }

  .summary {
    margin-top: 0.35rem;
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.55;
  }
</style>

