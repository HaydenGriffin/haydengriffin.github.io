---
/**
 * A public project shown as a card in a two-column grid: its hero image, its latest release, what it is, and where to go next.
 * The image and title open the project page; the try-it demo and full clips live there.
 * On a desktop pointer, a project with a clip plays it over the image while the card is hovered or focused.
 */
import { Image } from "astro:assets";
import type { Link, Project } from "../data/types";
import { getRepo } from "../lib/github";

interface Props {
  /** A project with a repo and a hero image. */
  project: Project;
}

const { project } = Astro.props;
const hero = project.hero!;
const clip = project.clip;
const repo = await getRepo(project.repo!);
const page = `/projects/${project.repo}/`;
const demo = project.demo ?? repo.homepage;
const links: Link[] = [
  { label: "How it works", href: page },
  { label: "GitHub", href: repo.url },
  ...(demo ? [{ label: "Live demo", href: demo }] : []),
];
---

<article class="build" data-preview={clip ? "" : undefined}>
  <a class="shot" href={page} tabindex="-1">
    <Image
      src={hero.src}
      alt={hero.alt}
      widths={[400, 560, 800, 1100]}
      sizes="(max-width: 640px) calc(100vw - 3rem), 248px"
      loading="lazy"
    />
    {
      clip && (
        <video
          class:list={["preview", clip.shape]}
          style={clip.position ? `object-position: ${clip.position}` : undefined}
          muted
          loop
          playsinline
          preload="none"
          aria-hidden="true"
          tabindex="-1"
        >
          <source src={`/clips/${clip.name}.webm`} type="video/webm" />
          <source src={`/clips/${clip.name}.mp4`} type="video/mp4" />
        </video>
      )
    }
  </a>
  <h4 class="line">
    <a class="title" href={page} style={`view-transition-name: project-${project.repo}`}>{project.name}</a>
    {
      repo.release && (
        <a class="version" href={repo.release.url} aria-label={`Latest release, ${repo.release.tag}`}>
          {repo.release.tag}
        </a>
      )
    }
  </h4>
  <p class="summary">{project.summary}</p>
  <p class="links">
    {links.map((link) => <a href={link.href}>{link.label}</a>)}
  </p>
</article>

<style>
  .build {
    display: grid;
    align-content: start;
  }

  .shot {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    margin-bottom: 0.875rem;
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: 10px;
    background: var(--hover);
    transition: border-color 200ms var(--ease);
  }

  .build:has(.title:hover) .shot,
  .shot:hover {
    border-color: var(--muted);
  }

  .shot img,
  .preview {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .shot img {
    object-fit: cover;
    object-position: 50% 0;
  }

  /* The clip sits on the image, hidden until its first frame plays, so the image is its poster and nothing moves. */
  .preview {
    object-fit: cover;
    opacity: 0;
    transition: opacity 200ms var(--ease);
  }

  /* A phone clip is shown whole; the image behind it, blurred, fills the sides. */
  .preview.phone {
    object-fit: contain;
    background: color-mix(in srgb, var(--bg) 35%, transparent);
    backdrop-filter: blur(14px);
  }

  .build.playing .preview {
    opacity: 1;
    transition-duration: 300ms;
  }

  /* Touch screens and reduced motion get the still image only; with preload="none" the clip never downloads. */
  @media (hover: none), (pointer: coarse), (prefers-reduced-motion: reduce) {
    .preview {
      display: none;
    }
  }

  .line {
    margin: 0;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    font-size: 1rem;
    font-weight: 500;
  }

  .title {
    text-decoration: none;
  }

  .title:hover {
    text-decoration: underline;
    text-decoration-color: currentColor;
  }

  .version {
    flex: none;
    color: var(--muted);
    font-size: 0.875rem;
    font-weight: 400;
    text-decoration: none;
  }

  .version:hover {
    color: var(--fg);
  }

  .summary {
    margin-top: 0.25rem;
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.1rem;
    margin-top: 0.5rem;
    font-size: 0.9375rem;
  }
</style>

<script>
  // Hover or keyboard focus on a card plays its clip over the image; leaving stops it.
  const canPreview = window.matchMedia("(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)");

  document.querySelectorAll<HTMLElement>("[data-preview]").forEach((card) => {
    const video = card.querySelector<HTMLVideoElement>("video.preview")!;
    let wanted = false;

    const start = () => {
      if (!canPreview.matches) return;
      wanted = true;
      video.play().catch(() => {});
    };
    const stop = () => {
      wanted = false;
      card.classList.remove("playing");
      video.pause();
    };

    video.addEventListener("playing", () => {
      if (wanted) card.classList.add("playing");
      else video.pause();
    });
    card.addEventListener("pointerenter", start);
    card.addEventListener("pointerleave", () => {
      if (!card.querySelector(":focus-visible")) stop();
    });
    card.addEventListener("focusin", start);
    card.addEventListener("focusout", (event) => {
      if (!card.contains(event.relatedTarget as Node | null)) stop();
    });
  });
</script>
