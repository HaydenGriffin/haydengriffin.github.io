---
/**
 * A home build shown as a card: its hero image, its name, what it runs on and what it is.
 * The image and the name open the project page, where the releases, the code and each platform's build live.
 * Beside the name is the one thing worth reaching straight from the card: a live demo, or a note that the code is private.
 * On a desktop pointer a card's clip plays over its image while the card is hovered or focused.
 */
import { Image } from "astro:assets";
import { platformSlug } from "../data/home";
import type { Project } from "../data/types";
import { getRepo } from "../lib/github";
import { pageName } from "../lib/writeups";

interface Props {
  /** A project with a repo or a page, and a hero image. */
  project: Project;
}

const { project } = Astro.props;
const hero = project.hero!;
const clip = project.clip;
const name = pageName(project)!;
const repo = project.repo ? await getRepo(project.repo) : undefined;
const page = `/projects/${name}/`;
const demo = project.demo ?? repo?.homepage;
const platforms = (project.platforms ?? []).map((platform) => ({ name: platform.name, slug: platformSlug(platform.name) }));
const featured = Boolean(project.featured);
---

<article
  class:list={["build", { featured }]}
  data-platforms={platforms.map((platform) => platform.slug).join(" ")}
  data-preview={clip ? "" : undefined}
>
  <a class="shot" href={page} tabindex="-1" style={`view-transition-name: shot-${name}; view-transition-class: shot`}>
    <Image
      src={hero.src}
      alt={hero.alt}
      widths={featured ? [560, 800, 1100, 1600] : [400, 560, 800, 1100]}
      sizes={featured ? "(max-width: 640px) calc(100vw - 3rem), 528px" : "(max-width: 640px) calc(100vw - 3rem), 250px"}
      loading={featured ? "eager" : "lazy"}
    />
    {
      clip && (
        <video
          class:list={["preview", clip.shape]}
          style={clip.position ? `object-position: ${clip.position}` : undefined}
          muted
          loop
          playsinline
          preload="none"
          aria-hidden="true"
          tabindex="-1"
        >
          <source src={`/clips/${clip.name}.webm`} type="video/webm" />
          <source src={`/clips/${clip.name}.mp4`} type="video/mp4" />
        </video>
      )
    }
  </a>
  <div class="line">
    <h3 class="name">
      <a class="title" href={page} style={`view-transition-name: project-${name}`}>{project.name}</a>
    </h3>
    {demo ? <a class="aside" href={demo}>Live demo</a> : !repo && <span class="aside muted">Private code</span>}
  </div>
  {
    platforms.length > 0 && (
      <p class="platforms">
        {platforms.map((platform, index) => (
          <>
            {index > 0 && " · "}
            <span data-platform={platform.slug}>{platform.name}</span>
          </>
        ))}
      </p>
    )
  }
  <p class="summary">{project.summary}</p>
</article>

<style>
  .build {
    display: grid;
    align-content: start;
    transition: opacity 300ms var(--ease);
  }

  .featured {
    grid-column: 1 / -1;
  }

  .featured .summary {
    max-width: 30rem;
  }

  /* Picked out by a platform in the "Runs on" line: the builds that do not run on it step back. */
  .build.dimmed {
    opacity: 0.28;
  }

  .shot {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    margin-bottom: 0.8rem;
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: 10px;
    background: var(--hover);
    transition: border-color 200ms var(--ease);
  }

  .build:has(.title:hover) .shot,
  .shot:hover {
    border-color: var(--muted);
  }

  .shot img,
  .preview {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .shot img {
    object-fit: cover;
    object-position: 50% 0;
  }

  /* The clip sits on the image, hidden until its first frame plays, so the image is its poster and nothing moves. */
  .preview {
    object-fit: cover;
    opacity: 0;
    transition: opacity 200ms var(--ease);
  }

  /* A phone clip is shown whole; the image behind it, blurred, fills the sides. */
  .preview.phone {
    object-fit: contain;
    background: color-mix(in srgb, var(--bg) 35%, transparent);
    backdrop-filter: blur(14px);
  }

  .build.playing .preview {
    opacity: 1;
    transition-duration: 400ms;
  }

  /* Touch screens and reduced motion get the still image only; with preload="none" the clip never downloads. */
  @media (hover: none), (pointer: coarse), (prefers-reduced-motion: reduce) {
    .preview {
      display: none;
    }
  }

  .line {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  .name {
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.4;
  }

  .title {
    text-decoration: none;
  }

  .title:hover {
    text-decoration: underline;
    text-decoration-color: currentColor;
  }

  .aside {
    flex: none;
    font-size: 0.9375rem;
  }

  .platforms {
    margin-top: 0.1rem;
    color: var(--muted);
    font-size: 0.875rem;
  }

  .platforms span {
    transition: color 200ms var(--ease);
  }

  .platforms span.picked {
    color: var(--fg);
    font-weight: 500;
  }

  .summary {
    margin-top: 0.35rem;
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.55;
  }
</style>

<script>
  // Hover or keyboard focus on a card plays its clip over the image; leaving stops it.
  const canPreview = window.matchMedia("(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)");

  document.querySelectorAll<HTMLElement>("[data-preview]").forEach((card) => {
    const video = card.querySelector<HTMLVideoElement>("video.preview")!;
    let wanted = false;

    const start = () => {
      if (!canPreview.matches) return;
      wanted = true;
      video.play().catch(() => {});
    };
    const stop = () => {
      wanted = false;
      card.classList.remove("playing");
      video.pause();
    };

    video.addEventListener("playing", () => {
      if (wanted) card.classList.add("playing");
      else video.pause();
    });

    card.addEventListener("pointerenter", start);
    card.addEventListener("pointerleave", () => {
      if (!card.querySelector(":focus-visible")) stop();
    });
    card.addEventListener("focusin", start);
    card.addEventListener("focusout", (event) => {
      if (!card.contains(event.relatedTarget as Node | null)) stop();
    });
  });
</script>
